{
  "name": "novira-frontend",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "node ../scripts/tools/typecheck.mjs",
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:visual": "playwright test --project=visual",
    "i18n:todo": "node scripts/i18n-todo.mjs",
    "manual:check": "vitest run tests/manual.test.ts",
    "eol": "node ../scripts/tools/fix-eol.mjs",
    "licenses": "node scripts/oss-licenses.mjs",
    "check:eol": "node ../scripts/tools/check-eol.mjs",
    "manual": "node scripts/manual.mjs",
    "check": "npm run typecheck && npm run lint && vitest run && npm run check:eol",
    "audit": "npm audit --omit=dev",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "coverage:e2e": "node scripts/coverage-e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/hachi-maru-pop": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/potta-one": "^5.3.0",
    "@fontsource/rampart-one": "^5.3.1",
    "@fontsource/reggae-one": "^5.3.1",
    "@fontsource/rocknroll-one": "^5.3.1",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "^12.12.1",
    "gifenc": "^1.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.18.1",
    "three": "^0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "monocart-coverage-reports": "2.13.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
