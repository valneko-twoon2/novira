{
  "prompt": {
    "ckpt": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": {
          "$model": "sdxl-key"
        }
      }
    },
    "pos": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "1girl, brown hair",
        "clip": [
          "ckpt",
          1
        ]
      }
    },
    "neg": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "lowres",
        "clip": [
          "ckpt",
          1
        ]
      }
    },
    "source": {
      "class_type": "LoadImage",
      "inputs": {
        "image": {
          "$image": "photo.png"
        }
      }
    },
    "detector": {
      "class_type": "UltralyticsDetectorProvider",
      "inputs": {
        "model_name": "bbox/face_yolov8m.pt"
      }
    },
    "face": {
      "class_type": "FaceDetailer",
      "inputs": {
        "image": [
          "source",
          0
        ],
        "model": [
          "ckpt",
          0
        ],
        "clip": [
          "ckpt",
          1
        ],
        "vae": [
          "ckpt",
          2
        ],
        "guide_size": 512,
        "guide_size_for": true,
        "max_size": 1024,
        "seed": {
          "$seed": true
        },
        "steps": 20,
        "cfg": 6,
        "sampler_name": {
          "$sampler_name": "dpmpp_2m_k"
        },
        "scheduler": {
          "$scheduler": "dpmpp_2m_k"
        },
        "positive": [
          "pos",
          0
        ],
        "negative": [
          "neg",
          0
        ],
        "denoise": 0.4,
        "feather": 5,
        "noise_mask": true,
        "force_inpaint": true,
        "bbox_threshold": 0.5,
        "bbox_dilation": 10,
        "bbox_crop_factor": 3,
        "sam_detection_hint": "center-1",
        "sam_dilation": 0,
        "sam_threshold": 0.93,
        "sam_bbox_expansion": 0,
        "sam_mask_hint_threshold": 0.7,
        "sam_mask_hint_use_negative": "False",
        "drop_size": 10,
        "bbox_detector": [
          "detector",
          0
        ],
        "wildcard": "",
        "cycle": 1,
        "inpaint_model": false,
        "noise_mask_feather": 20,
        "tiled_encode": false,
        "tiled_decode": false
      }
    },
    "save": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "face",
          0
        ],
        "filename_prefix": "novira-face"
      }
    }
  },
  "outputs": [
    "save"
  ]
}
