{
  "prompt": {
    "source": {
      "class_type": "LoadImage",
      "inputs": {
        "image": {
          "$image": "photo.png"
        }
      }
    },
    "cover": {
      "class_type": "LoadImage",
      "inputs": {
        "image": {
          "$image": "mask.png"
        }
      }
    },
    "mask": {
      "class_type": "ImageToMask",
      "inputs": {
        "image": [
          "cover",
          0
        ],
        "channel": "red"
      }
    },
    "grow": {
      "class_type": "INPAINT_ExpandMask",
      "inputs": {
        "mask": [
          "mask",
          0
        ],
        "grow": 12,
        "blur": 6,
        "blur_type": "gaussian"
      }
    },
    "fill": {
      "class_type": "INPAINT_MaskedFill",
      "inputs": {
        "image": [
          "source",
          0
        ],
        "mask": [
          "grow",
          0
        ],
        "fill": "telea",
        "falloff": 0
      }
    },
    "save": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "fill",
          0
        ],
        "filename_prefix": "novira-erase"
      }
    }
  },
  "outputs": [
    "save"
  ]
}
