{
  "prompt": {
    "source": {
      "class_type": "LoadImage",
      "inputs": {
        "image": {
          "$image": "photo.png"
        }
      }
    },
    "cut": {
      "class_type": "RMBG",
      "inputs": {
        "image": [
          "source",
          0
        ],
        "model": "RMBG-2.0",
        "sensitivity": 1,
        "process_res": 1024,
        "mask_blur": 0,
        "mask_offset": 0,
        "invert_output": false,
        "refine_foreground": false,
        "background": "Alpha"
      }
    },
    "save": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "cut",
          0
        ],
        "filename_prefix": "novira-cutout"
      }
    }
  },
  "outputs": [
    "save"
  ]
}
