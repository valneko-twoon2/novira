{
  "graph": {
    "prompt": {
      "model": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": {
            "$model": "main-key"
          }
        }
      },
      "pos": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "a cute puppy sitting in a sunny meadow, detailed fur, soft light",
          "clip": [
            "model",
            1
          ]
        }
      },
      "neg": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "blurry, low quality, watermark",
          "clip": [
            "model",
            1
          ]
        }
      },
      "noise": {
        "class_type": "EmptyLatentImage",
        "inputs": {
          "width": 1024,
          "height": 1024,
          "batch_size": 1
        }
      },
      "denoise": {
        "class_type": "KSampler",
        "inputs": {
          "model": [
            "model",
            0
          ],
          "seed": {
            "$seed": true
          },
          "steps": 30,
          "cfg": 6,
          "sampler_name": {
            "$sampler_name": "dpmpp_2m_k"
          },
          "scheduler": {
            "$scheduler": "dpmpp_2m_k"
          },
          "positive": [
            "pos",
            0
          ],
          "negative": [
            "neg",
            0
          ],
          "latent_image": [
            "noise",
            0
          ],
          "denoise": 1
        }
      },
      "decode": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "denoise",
            0
          ],
          "vae": [
            "model",
            2
          ]
        }
      },
      "detector": {
        "class_type": "UltralyticsDetectorProvider",
        "inputs": {
          "model_name": "bbox/face_yolov8m.pt"
        }
      },
      "face": {
        "class_type": "FaceDetailer",
        "inputs": {
          "image": [
            "decode",
            0
          ],
          "model": [
            "model",
            0
          ],
          "clip": [
            "model",
            1
          ],
          "vae": [
            "model",
            2
          ],
          "guide_size": 512,
          "guide_size_for": true,
          "max_size": 1024,
          "seed": 0,
          "steps": 20,
          "cfg": 6,
          "sampler_name": "dpmpp_2m",
          "scheduler": "karras",
          "positive": [
            "pos",
            0
          ],
          "negative": [
            "neg",
            0
          ],
          "denoise": 0.4,
          "feather": 5,
          "noise_mask": true,
          "force_inpaint": true,
          "bbox_threshold": 0.5,
          "bbox_dilation": 10,
          "bbox_crop_factor": 3,
          "sam_detection_hint": "center-1",
          "sam_dilation": 0,
          "sam_threshold": 0.93,
          "sam_bbox_expansion": 0,
          "sam_mask_hint_threshold": 0.7,
          "sam_mask_hint_use_negative": "False",
          "drop_size": 10,
          "bbox_detector": [
            "detector",
            0
          ],
          "wildcard": "",
          "cycle": 1,
          "inpaint_model": false,
          "noise_mask_feather": 20,
          "tiled_encode": false,
          "tiled_decode": false
        }
      },
      "save": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "face",
            0
          ],
          "filename_prefix": "novira"
        }
      }
    },
    "outputs": [
      "save"
    ]
  },
  "seed": null,
  "random": true
}
