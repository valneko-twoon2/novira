{
  "graph": {
    "prompt": {
      "model": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": {
            "$model": "main-key"
          }
        }
      },
      "pos": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "a cute puppy sitting in a sunny meadow, detailed fur, soft light",
          "clip": [
            "model",
            1
          ]
        }
      },
      "neg": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "blurry, low quality, watermark",
          "clip": [
            "model",
            1
          ]
        }
      },
      "noise": {
        "class_type": "EmptyLatentImage",
        "inputs": {
          "width": 1024,
          "height": 1024,
          "batch_size": 1
        }
      },
      "denoise": {
        "class_type": "KSampler",
        "inputs": {
          "model": [
            "model",
            0
          ],
          "seed": {
            "$seed": true
          },
          "steps": 30,
          "cfg": 6,
          "sampler_name": {
            "$sampler_name": "dpmpp_2m_k"
          },
          "scheduler": {
            "$scheduler": "dpmpp_2m_k"
          },
          "positive": [
            "pos",
            0
          ],
          "negative": [
            "neg",
            0
          ],
          "latent_image": [
            "noise",
            0
          ],
          "denoise": 1
        }
      },
      "decode": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "denoise",
            0
          ],
          "vae": [
            "model",
            2
          ]
        }
      },
      "grain": {
        "class_type": "NKDFilmGrain",
        "inputs": {
          "image": [
            "decode",
            0
          ],
          "amount": 30,
          "size": 25,
          "roughness": 50,
          "color": 0,
          "animate": false,
          "seed": 0
        }
      },
      "save": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "grain",
            0
          ],
          "filename_prefix": "novira"
        }
      }
    },
    "outputs": [
      "save"
    ]
  },
  "seed": null,
  "random": true
}
