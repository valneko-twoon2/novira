{
  "graph": {
    "prompt": {
      "model": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": {
            "$model": "main-key"
          }
        }
      },
      "pos": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "a cute puppy sitting in a sunny meadow, detailed fur, soft light",
          "clip": [
            "model",
            1
          ]
        }
      },
      "neg": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "blurry, low quality, watermark",
          "clip": [
            "model",
            1
          ]
        }
      },
      "control": {
        "class_type": "ControlNetLoader",
        "inputs": {
          "control_net_name": {
            "$model": "controlnet-key"
          }
        }
      },
      "source": {
        "class_type": "LoadImage",
        "inputs": {
          "image": {
            "$image": "photo.png"
          }
        }
      },
      "canny": {
        "class_type": "Canny",
        "inputs": {
          "image": [
            "source",
            0
          ],
          "low_threshold": 0.39215686274509803,
          "high_threshold": 0.7843137254901961
        }
      },
      "denoise:control": {
        "class_type": "ControlNetApplyAdvanced",
        "inputs": {
          "positive": [
            "pos",
            0
          ],
          "negative": [
            "neg",
            0
          ],
          "control_net": [
            "control",
            0
          ],
          "image": [
            "canny",
            0
          ],
          "strength": 1,
          "start_percent": 0,
          "end_percent": 1
        }
      },
      "noise": {
        "class_type": "EmptyLatentImage",
        "inputs": {
          "width": 1024,
          "height": 1024,
          "batch_size": 1
        }
      },
      "denoise": {
        "class_type": "KSampler",
        "inputs": {
          "model": [
            "model",
            0
          ],
          "seed": {
            "$seed": true
          },
          "steps": 30,
          "cfg": 6,
          "sampler_name": {
            "$sampler_name": "dpmpp_2m_k"
          },
          "scheduler": {
            "$scheduler": "dpmpp_2m_k"
          },
          "positive": [
            "denoise:control",
            0
          ],
          "negative": [
            "denoise:control",
            1
          ],
          "latent_image": [
            "noise",
            0
          ],
          "denoise": 1
        }
      },
      "decode": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "denoise",
            0
          ],
          "vae": [
            "model",
            2
          ]
        }
      },
      "save": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "decode",
            0
          ],
          "filename_prefix": "novira"
        }
      }
    },
    "outputs": [
      "save"
    ]
  },
  "seed": null,
  "random": true
}
