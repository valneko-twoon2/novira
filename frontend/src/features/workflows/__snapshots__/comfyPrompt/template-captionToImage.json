{
  "graph": {
    "prompt": {
      "source": {
        "class_type": "LoadImage",
        "inputs": {
          "image": {
            "$image": "photo.png"
          }
        }
      },
      "florence": {
        "class_type": "DownloadAndLoadFlorence2Model",
        "inputs": {
          "model": "microsoft/Florence-2-base",
          "precision": "fp16",
          "convert_to_safetensors": false
        }
      },
      "caption": {
        "class_type": "Florence2Run",
        "inputs": {
          "image": [
            "source",
            0
          ],
          "florence2_model": [
            "florence",
            0
          ],
          "text_input": "",
          "task": "detailed_caption",
          "fill_mask": true,
          "keep_model_loaded": false,
          "max_new_tokens": 1024,
          "num_beams": 3,
          "do_sample": true,
          "output_mask_select": "",
          "seed": 1
        }
      },
      "model": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": {
            "$model": "main-key"
          }
        }
      },
      "pos": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": [
            "caption",
            2
          ],
          "clip": [
            "model",
            1
          ]
        }
      },
      "neg": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "blurry, low quality, watermark",
          "clip": [
            "model",
            1
          ]
        }
      },
      "noise": {
        "class_type": "EmptyLatentImage",
        "inputs": {
          "width": 1024,
          "height": 1024,
          "batch_size": 1
        }
      },
      "denoise": {
        "class_type": "KSampler",
        "inputs": {
          "model": [
            "model",
            0
          ],
          "seed": {
            "$seed": true
          },
          "steps": 30,
          "cfg": 6,
          "sampler_name": {
            "$sampler_name": "dpmpp_2m_k"
          },
          "scheduler": {
            "$scheduler": "dpmpp_2m_k"
          },
          "positive": [
            "pos",
            0
          ],
          "negative": [
            "neg",
            0
          ],
          "latent_image": [
            "noise",
            0
          ],
          "denoise": 1
        }
      },
      "decode": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "denoise",
            0
          ],
          "vae": [
            "model",
            2
          ]
        }
      },
      "save": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "decode",
            0
          ],
          "filename_prefix": "novira"
        }
      }
    },
    "outputs": [
      "save"
    ]
  },
  "seed": null,
  "random": true
}
