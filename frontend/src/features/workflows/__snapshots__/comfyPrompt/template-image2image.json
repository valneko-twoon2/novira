{
  "graph": {
    "prompt": {
      "model": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": {
            "$model": "main-key"
          }
        }
      },
      "pos": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "a cute puppy sitting in a sunny meadow, detailed fur, soft light",
          "clip": [
            "model",
            1
          ]
        }
      },
      "neg": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "blurry, low quality, watermark",
          "clip": [
            "model",
            1
          ]
        }
      },
      "source": {
        "class_type": "LoadImage",
        "inputs": {
          "image": {
            "$image": "photo.png"
          }
        }
      },
      "encode": {
        "class_type": "VAEEncode",
        "inputs": {
          "pixels": [
            "source",
            0
          ],
          "vae": [
            "model",
            2
          ]
        }
      },
      "denoise": {
        "class_type": "KSampler",
        "inputs": {
          "model": [
            "model",
            0
          ],
          "seed": {
            "$seed": true
          },
          "steps": 30,
          "cfg": 6,
          "sampler_name": {
            "$sampler_name": "dpmpp_2m_k"
          },
          "scheduler": {
            "$scheduler": "dpmpp_2m_k"
          },
          "positive": [
            "pos",
            0
          ],
          "negative": [
            "neg",
            0
          ],
          "latent_image": [
            "encode",
            0
          ],
          "denoise": 0.5
        }
      },
      "decode": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "denoise",
            0
          ],
          "vae": [
            "model",
            2
          ]
        }
      },
      "save": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "decode",
            0
          ],
          "filename_prefix": "novira"
        }
      }
    },
    "outputs": [
      "save"
    ]
  },
  "seed": null,
  "random": true
}
