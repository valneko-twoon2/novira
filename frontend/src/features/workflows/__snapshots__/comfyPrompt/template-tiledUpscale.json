{
  "graph": {
    "prompt": {
      "source": {
        "class_type": "LoadImage",
        "inputs": {
          "image": {
            "$image": "photo.png"
          }
        }
      },
      "resize": {
        "class_type": "ImageScale",
        "inputs": {
          "image": [
            "source",
            0
          ],
          "upscale_method": "lanczos",
          "width": 2048,
          "height": 2048,
          "crop": "disabled"
        }
      },
      "model": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
          "ckpt_name": {
            "$model": "main-key"
          }
        }
      },
      "pos": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "highly detailed, sharp focus",
          "clip": [
            "model",
            1
          ]
        }
      },
      "neg": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "blurry, low quality, watermark",
          "clip": [
            "model",
            1
          ]
        }
      },
      "tiles": {
        "class_type": "UltimateSDUpscaleNoUpscale",
        "inputs": {
          "upscaled_image": [
            "resize",
            0
          ],
          "model": [
            "model",
            0
          ],
          "positive": [
            "pos",
            0
          ],
          "negative": [
            "neg",
            0
          ],
          "vae": [
            "model",
            2
          ],
          "seed": 0,
          "steps": 20,
          "cfg": 6,
          "sampler_name": "dpmpp_2m",
          "scheduler": "karras",
          "denoise": 0.3,
          "mode_type": "Linear",
          "tile_width": 1024,
          "tile_height": 1024,
          "mask_blur": 8,
          "tile_padding": 32,
          "seam_fix_mode": "None",
          "seam_fix_denoise": 1,
          "seam_fix_width": 64,
          "seam_fix_mask_blur": 8,
          "seam_fix_padding": 16,
          "force_uniform_tiles": true,
          "tiled_decode": false,
          "batch_size": 1
        }
      },
      "save": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "tiles",
            0
          ],
          "filename_prefix": "novira"
        }
      }
    },
    "outputs": [
      "save"
    ]
  },
  "seed": null,
  "random": false
}
